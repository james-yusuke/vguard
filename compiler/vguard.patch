diff --git a/vlib/v/gen/arm64/vguard.v b/vlib/v/gen/arm64/vguard.v
new file mode 100644
index 0000000000..77c63c2274
--- /dev/null
+++ b/vlib/v/gen/arm64/vguard.v
@@ -0,0 +1,47 @@
+module arm64
+
+import v.ssa
+
+fn (mut g Gen) record_vguard_homes(function string) {
+	for index in g.slot_value_indices {
+		g.vguard_homes << g.vguard_home(function, index, g.vguard_arguments[g.slot_value_base + index])
+	}
+	for index in g.value_home_ids {
+		if g.value_homes[index] != 0 && g.stack_offsets[index] == 0 && g.alloca_offsets[index] == 0 {
+			g.vguard_homes << g.vguard_home(function, index, ssa.VGuardArgumentEntry{})
+		}
+	}
+}
+
+fn (g &Gen) vguard_home(function string, index int, argument ssa.VGuardArgumentEntry) ssa.VGuardValueHome {
+	value := g.slot_value_base + index
+	reg := g.value_home_reg(value)
+	region := g.vguard_stack_regions[value]
+	return ssa.VGuardValueHome{
+		function:         function
+		value:            value
+		register:         if reg == 0 {
+			''
+		} else if is_float_home(reg) {
+			'd${float_home_reg(reg)}'
+		} else {
+			'x${reg}'
+		}
+		frame_offset:     int(g.stack_offsets[index])
+		object_offset:    int(g.alloca_offsets[index])
+		object_size:      region.size
+		redzone_before:   region.before
+		redzone_after:    region.after
+		argument_entry:   argument
+		object_alignment: if g.alloca_alignments[index] > 16 {
+			int(g.alloca_alignments[index])
+		} else {
+			0
+		}
+	}
+}
+
+// vguard_value_homes returns the assignments from emitted functions.
+pub fn (g &Gen) vguard_value_homes() []ssa.VGuardValueHome {
+	return g.vguard_homes
+}
