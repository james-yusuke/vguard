diff --git a/vlib/sync/vguard_d_vguard_hang_trace.c.v b/vlib/sync/vguard_d_vguard_hang_trace.c.v
new file mode 100644
index 0000000000..9c97d01e86
--- /dev/null
+++ b/vlib/sync/vguard_d_vguard_hang_trace.c.v
@@ -0,0 +1,32 @@
+module sync
+
+// A single stdio call keeps records from different threads intact.
+fn vguard_mutex_event(m &Mutex, action u8) {
+	vguard_lock_event(voidptr(m), action)
+}
+
+fn vguard_lock_event(address voidptr, action u8) {
+	C.fprintf(C.stderr, c'\036VGUARD-MUTEX\t%llu\t%llu\t%p\t%c\n', v_getpid(), v_gettid(),
+		address, int(action))
+}
+
+// Report the pthread object's extent without exposing its libc-specific layout.
+fn vguard_wait_lock(address voidptr, action u8, pthread_object voidptr, size usize) {
+	$if linux {
+		C.fprintf(C.stderr, c'\036VGUARD-MUTEX\t%llu\t%llu\t%p\t%c\t%p\t%zu\n', v_getpid(),
+			v_gettid(), address, int(action), pthread_object, size)
+	} $else {
+		vguard_lock_event(address, action)
+	}
+}
+
+// The Linux analyzer can correlate the wait with the actual sem_t address.
+fn vguard_channel_wait(address voidptr, action u8, semaphore &Semaphore) {
+	$if linux {
+		C.fprintf(C.stderr, c'\036VGUARD-CHANNEL\t%llu\t%llu\t%p\t%c\t%p\n', v_getpid(),
+			v_gettid(), address, int(action), voidptr(&semaphore.sem))
+	} $else {
+		C.fprintf(C.stderr, c'\036VGUARD-CHANNEL\t%llu\t%llu\t%p\t%c\n', v_getpid(),
+			v_gettid(), address, int(action))
+	}
+}
