diff --git a/vlib/v/ssa/optimize/vguard_trace.v b/vlib/v/ssa/optimize/vguard_trace.v
new file mode 100644
index 0000000000..75ce29da51
--- /dev/null
+++ b/vlib/v/ssa/optimize/vguard_trace.v
@@ -0,0 +1,183 @@
+module optimize
+
+import strings
+import os
+import v.flat
+import v.ssa
+
+struct VGuardInstructionChange {
+	before ssa.VGuardInstruction
+	after  ssa.VGuardInstruction
+}
+
+struct VGuardFinding {
+	severity string
+	detail   VerifyError
+}
+
+struct VGuardPass {
+	version      int = 1
+	kind         string
+	pass         string
+	verifier_ran bool
+	before_count int
+	after_count  int
+	created      []ssa.VGuardInstruction
+	removed      []ssa.VGuardInstruction
+	changed      []VGuardInstructionChange
+	rewrites     []ssa.VGuardRewrite
+	findings     []VGuardFinding
+}
+
+@[heap]
+pub struct VGuardTrace {
+mut:
+	file     os.File
+	ast      &flat.FlatAst
+	previous map[int]ssa.VGuardInstruction
+	started  bool
+	failure  string
+}
+
+fn same_vguard_instruction(a ssa.VGuardInstruction, b ssa.VGuardInstruction) bool {
+	return a.block == b.block && a.function == b.function && a.op == b.op && a.typ == b.typ
+		&& a.atomic == b.atomic && a.inline == b.inline && a.asm_id == b.asm_id
+		&& a.operands == b.operands && a.ast.node == b.ast.node
+		&& a.ast.copied_from == b.ast.copied_from
+}
+
+fn (mut trace VGuardTrace) checkpoint(mut m ssa.Module, pass string, verify_pass bool) {
+	if trace.failure != '' {
+		return
+	}
+	graph := m.vguard_graph(trace.ast)
+	mut current := map[int]ssa.VGuardInstruction{}
+	mut created := []ssa.VGuardInstruction{}
+	mut changed := []VGuardInstructionChange{}
+	mut removed := []ssa.VGuardInstruction{}
+	for instruction in graph.instructions {
+		current[instruction.id] = instruction
+		if before := trace.previous[instruction.id] {
+			if !same_vguard_instruction(before, instruction) {
+				changed << VGuardInstructionChange{ before: before, after: instruction }
+			}
+		} else {
+			created << instruction
+		}
+	}
+	for id in trace.previous.keys().sorted() {
+		if id !in current {
+			removed << trace.previous[id]
+		}
+	}
+	mut findings := []VGuardFinding{}
+	if verify_pass {
+		for finding in verify(m) {
+			if !is_accepted_declaration_verify_error(m, finding) {
+				findings << VGuardFinding{
+					severity: if is_legacy_noncritical_verify_error(finding) {
+						'advisory'
+					} else {
+						'critical'
+					}
+					detail:   finding
+				}
+			}
+		}
+	}
+	event := VGuardPass{
+		kind:         if trace.started { 'pass' } else { 'baseline' }
+		pass:         pass
+		verifier_ran: verify_pass
+		before_count: trace.previous.len
+		after_count:  current.len
+		created:      created
+		removed:      removed
+		changed:      changed
+		rewrites:     m.vguard_rewrites
+		findings:     findings
+	}
+	trace.file.write_string(event.json_line()) or {
+		trace.failure = err.msg()
+		return
+	}
+	trace.file.flush()
+	trace.started = true
+	trace.previous = current
+	m.vguard_rewrites = []
+}
+
+// trace_vguard_pipeline observes the existing production pipeline. A skipped
+// pipeline records its reason and saves the actual unoptimized graph.
+pub fn trace_vguard_pipeline(mut m ssa.Module, a &flat.FlatAst, path string, skip_reason string) ! {
+	mut trace := &VGuardTrace{
+		file: os.create(path)!
+		ast:  a
+	}
+	m.vguard_track_rewrites = true
+	defer {
+		trace.file.close()
+		m.vguard_track_rewrites = false
+		m.vguard_rewrites = []
+	}
+	if skip_reason == '' {
+		optimize_with_options(mut m, OptimizeOptions{
+			mem2reg:          true
+			eliminate_phis:   true
+			verify_each_pass: os.getenv('V3_VERIFY') != ''
+			strict_verify:    os.getenv('V3_VERIFY_STRICT') != ''
+			vguard_trace:     trace
+		})
+	} else {
+		trace.checkpoint(mut m, skip_reason, false)
+	}
+	if trace.failure != '' {
+		return error(trace.failure)
+	}
+	os.write_file(path + '.graph.json', m.vguard_graph(a).vguard_json())!
+}
+
+fn trace_vguard_checkpoint(mut m ssa.Module, opts OptimizeOptions, pass string, verify_pass bool) {
+	if opts.vguard_trace != unsafe { nil } {
+		mut trace := opts.vguard_trace
+		trace.checkpoint(mut m, pass, verify_pass)
+	}
+}
+
+fn (event VGuardPass) json_line() string {
+	mut out := strings.new_builder(4096)
+	out.write_string('{"version":${event.version},"kind":${ssa.vguard_json_quote(event.kind)},"pass":${ssa.vguard_json_quote(event.pass)}')
+	out.write_string(',"verifier_ran":${event.verifier_ran},"before_count":${event.before_count},"after_count":${event.after_count},"created":')
+	ssa.write_vguard_instructions(mut out, event.created)
+	out.write_string(',"removed":')
+	ssa.write_vguard_instructions(mut out, event.removed)
+	out.write_string(',"changed":[')
+	for index, change in event.changed {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		out.write_string('{"before":')
+		change.before.write_vguard_json(mut out)
+		out.write_string(',"after":')
+		change.after.write_vguard_json(mut out)
+		out.write_u8(`}`)
+	}
+	out.write_string('],"rewrites":[')
+	for index, rewrite in event.rewrites {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		out.write_string('{"from":${rewrite.from},"to":${rewrite.to},"user":${rewrite.user}}')
+	}
+	out.write_string('],"findings":[')
+	for index, finding in event.findings {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		detail := finding.detail
+		out.write_string('{"severity":${ssa.vguard_json_quote(finding.severity)},"message":${ssa.vguard_json_quote(detail.msg)}')
+		out.write_string(',"function":${ssa.vguard_json_quote(detail.func_name)},"function_id":${detail.func_id},"block":${detail.block_id},"value":${detail.val_id}}')
+	}
+	out.writeln(']}')
+	return out.str()
+}
