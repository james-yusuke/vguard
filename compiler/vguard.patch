diff --git a/vlib/v/ssa/vguard.v b/vlib/v/ssa/vguard.v
new file mode 100644
index 0000000000..d53abf012d
--- /dev/null
+++ b/vlib/v/ssa/vguard.v
@@ -0,0 +1,32 @@
+module ssa
+
+import v.token
+
+// EmissionRange connects emitted bytes inside a function to a final SSA instruction.
+pub struct EmissionRange {
+pub:
+	function string
+	body     int
+	start    int
+	end      int
+	value    ValueID
+	op       OpCode
+	pos      token.Pos
+pub mut:
+	symbol string
+}
+
+// emission_range describes bytes attributed to one instruction.
+pub fn (m &Module) emission_range(function string, symbol string, body int, start int, end int, value ValueID) EmissionRange {
+	ins := m.instrs[m.values[value].index]
+	return EmissionRange{
+		function: function
+		symbol:   symbol
+		body:     body
+		start:    start
+		end:      end
+		value:    value
+		op:       ins.op
+		pos:      ins.pos
+	}
+}
