index 0000000000..898a456b79
--- /dev/null
+++ b/vlib/v/gen/amd64/vguard.v
@@ -0,0 +1,35 @@
+module amd64
+
+import v.ssa
+
+fn (mut g Gen) record_vguard_homes(function string) {
+	for value in g.stack_map.keys().sorted() {
+		region := g.vguard_stack_regions[value]
+		g.vguard_homes << ssa.VGuardValueHome{
+			function:       function
+			value:          value
+			register:       if reg := g.reg_map[value] { asm_register_names[reg] } else { '' }
+			frame_offset:   g.stack_map[value]
+			object_offset:  g.alloca_offsets[value]
+			object_size:    region.size
+			redzone_before: region.before
+			redzone_after:  region.after
+			argument_entry: g.vguard_arguments[value]
+		}
+	}
+	for value in g.reg_map.keys().sorted() {
+		if value !in g.stack_map {
+			g.vguard_homes << ssa.VGuardValueHome{
+				function:       function
+				value:          value
+				register:       asm_register_names[g.reg_map[value]]
+				argument_entry: g.vguard_arguments[value]
+			}
+		}
+	}
+}
+
+// vguard_value_homes returns the assignments from emitted functions.
+pub fn (g &Gen) vguard_value_homes() []ssa.VGuardValueHome {
+	return g.vguard_homes
+}
