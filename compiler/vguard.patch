index 0000000000..3a10eb37df
--- /dev/null
+++ b/vlib/v/gen/arm64/vguard_memory.v
@@ -0,0 +1,86 @@
+module arm64
+
+import v.ssa
+
+fn (mut g Gen) vguard_check_scalar(ptr_id int, width int, write bool) {
+	g.vguard_check_access(ptr_id, if width in [1, 2, 4] { width } else { 8 }, write)
+}
+
+fn (mut g Gen) vguard_check_access(ptr_id int, size int, write bool) {
+	if size <= 0 {
+		return
+	}
+	pointer := g.load_val(ptr_id, 0)
+	if pointer != 0 {
+		g.emit32(asm_mov_reg(Reg(0), Reg(pointer)))
+	}
+	g.vguard_shadow_call('__asan_region_is_poisoned', size)
+	skip := g.text_offset()
+	g.emit32(asm_cbz(Reg(0), 0))
+	// Report with the generated frame's PC, frame pointer and stack pointer.
+	g.emit32(asm_mov_reg(Reg(3), Reg(0)))
+	g.emit32(asm_adr_here(Reg(0)))
+	g.emit32(asm_mov_reg(Reg(1), fp))
+	g.emit32(asm_add_imm(Reg(2), sp, 0))
+	g.emit_mov_imm(4, if write { 1 } else { 0 })
+	g.emit_mov_imm(5, i64(size))
+	g.vguard_runtime_call('__asan_report_error')
+	g.text_words[skip / 4] = asm_cbz(Reg(0), i32((g.text_offset() - skip) / 4))
+}
+
+fn (mut g Gen) vguard_poison_frame() {
+	for value in g.vguard_stack_regions.keys().sorted() {
+		region := g.vguard_stack_regions[value]
+		g.emit_lea_fp(0, region.offset - region.before)
+		g.vguard_shadow_call('__asan_poison_memory_region', region.before)
+		g.emit_lea_fp(0, region.offset + region.size)
+		g.vguard_shadow_call('__asan_poison_memory_region', region.after)
+	}
+}
+
+fn (mut g Gen) vguard_unpoison_frame() {
+	g.emit_lea_fp(0, -g.stack_size)
+	g.vguard_shadow_call('__asan_unpoison_memory_region', g.stack_size)
+}
+
+fn (mut g Gen) vguard_shadow_call(name string, size int) {
+	g.emit_mov_imm(1, i64(size))
+	g.vguard_runtime_call(name)
+}
+
+fn (mut g Gen) vguard_runtime_call(name string) {
+	symbol := g.macho.add_undefined('_' + name)
+	g.macho.add_reloc(g.text_offset(), symbol, arm64_reloc_branch26, true)
+	g.emit32(asm_bl(0))
+}
+
+fn (mut g Gen) vguard_register_globals() {
+	globals := g.m.vguard_defined_globals()
+	if globals.len == 0 {
+		return
+	}
+	g.emit_global_addr(9, ssa.vguard_global_table)
+	for index, global in globals {
+		offset := index * ssa.vguard_global_record_size
+		g.emit_global_addr(8, global.name)
+		g.emit_store_reg_offset(Reg(8), Reg(9), offset)
+		g.emit_mov_imm(8, i64(global.size))
+		g.emit_store_reg_offset(Reg(8), Reg(9), offset + 8)
+		g.emit_mov_imm(8, i64(global.span))
+		g.emit_store_reg_offset(Reg(8), Reg(9), offset + 16)
+		g.vguard_string_address(8, global.name)
+		g.emit_store_reg_offset(Reg(8), Reg(9), offset + 24)
+		g.vguard_string_address(8, 'VGuard native globals')
+		g.emit_store_reg_offset(Reg(8), Reg(9), offset + 32)
+	}
+	g.emit32(asm_mov_reg(Reg(0), Reg(9)))
+	g.vguard_shadow_call('__asan_register_globals', globals.len)
+}
+
+fn (mut g Gen) vguard_string_address(reg int, name string) {
+	symbol := g.string_symbol(name)
+	g.macho.add_reloc(g.text_offset(), symbol, arm64_reloc_page21, true)
+	g.emit32(asm_adrp(Reg(reg)))
+	g.macho.add_reloc(g.text_offset(), symbol, arm64_reloc_pageoff12, false)
+	g.emit32(asm_add_pageoff(Reg(reg)))
+}
