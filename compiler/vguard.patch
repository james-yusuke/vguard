diff --git a/vlib/v/ssa/vguard.v b/vlib/v/ssa/vguard.v
new file mode 100644
index 0000000000..d53abf012d
--- /dev/null
+++ b/vlib/v/ssa/vguard.v
@@ -0,0 +1,32 @@
+module ssa
+
+import v.token
+
+// EmissionRange connects emitted bytes inside a function to a final SSA instruction.
+pub struct EmissionRange {
+pub:
+	function string
+	body     int
+	start    int
+	end      int
+	value    ValueID
+	op       OpCode
+	pos      token.Pos
+pub mut:
+	symbol string
+}
+
+// emission_range describes bytes attributed to one instruction.
+pub fn (m &Module) emission_range(function string, symbol string, body int, start int, end int, value ValueID) EmissionRange {
+	ins := m.instrs[m.values[value].index]
+	return EmissionRange{
+		function: function
+		symbol:   symbol
+		body:     body
+		start:    start
+		end:      end
+		value:    value
+		op:       ins.op
+		pos:      ins.pos
+	}
+}
diff --git a/vlib/v/ssa/vguard_graph.v b/vlib/v/ssa/vguard_graph.v
new file mode 100644
index 0000000000..79dfe5888f
--- /dev/null
+++ b/vlib/v/ssa/vguard_graph.v
@@ -0,0 +1,239 @@
+module ssa
+
+import strings
+import v.flat
+import v.errors
+
+// VGuardOperand records the role assigned by the compiler, including phi edges
+// and the destination of lowered phi copies.
+pub struct VGuardOperand {
+pub:
+	id   int
+	role string
+	kind string
+}
+
+struct VGuardAstAnchor {
+	node        int
+	copied_from int = -1
+}
+
+// VGuardAst is the builder's active FlatAst node at instruction allocation.
+pub struct VGuardAst {
+pub:
+	node        int = -1
+	kind        string
+	file        string
+	line        int
+	column      int
+	source_file string
+	start_byte  int
+	end_byte    int
+	copied_from int = -1
+}
+
+pub struct VGuardInstruction {
+pub:
+	id       int
+	block    int
+	function string
+	op       string
+	typ      int
+	atomic   string
+	inline   string
+	asm_id   int
+	operands []VGuardOperand
+	ast      VGuardAst
+}
+
+pub struct VGuardBlock {
+pub:
+	id           int
+	function     string
+	instructions []int
+	successors   []int
+}
+
+pub struct VGuardGraph {
+pub:
+	version      int = 1
+	instructions []VGuardInstruction
+	blocks       []VGuardBlock
+}
+
+pub struct VGuardRewrite {
+pub:
+	from int
+	to   int
+	user int
+}
+
+fn (m &Module) vguard_ast_at(a &flat.FlatAst, index int) VGuardAst {
+	anchor := m.vguard_ast_nodes[index] or { return VGuardAst{} }
+	node := a.nodes[anchor.node]
+	pos := a.source_position(node.pos) or { return VGuardAst{} }
+	physical := a.source_files[node.pos.id] or { return VGuardAst{} }
+	return VGuardAst{
+		node:        anchor.node
+		kind:        node.kind.str()
+		file:        pos.filename
+		line:        pos.line
+		column:      pos.column
+		source_file: physical.name
+		start_byte:  int(node.pos.offset)
+		end_byte:    int(node.pos.end)
+		copied_from: anchor.copied_from
+	}
+}
+
+// vguard_graph captures the live instruction lists and compiler operand roles.
+// Derive successor edges from terminators so this works before CFG analysis too.
+pub fn (m &Module) vguard_graph(a &flat.FlatAst) VGuardGraph {
+	mut instructions := []VGuardInstruction{}
+	mut blocks := []VGuardBlock{}
+	for func in m.funcs {
+		for block_id in func.blocks {
+			if block_id < 0 || block_id >= m.blocks.len {
+				continue
+			}
+			block := m.blocks[block_id]
+			mut members := []int{cap: block.instrs.len}
+			mut successors := []int{}
+			for id in block.instrs {
+				if id < 0 || id >= m.values.len {
+					continue
+				}
+				value := m.values[id]
+				if value.kind != .instruction || value.index < 0 || value.index >= m.instrs.len {
+					continue
+				}
+				instr := m.instrs[value.index]
+				mut operands := []VGuardOperand{cap: instr.operands.len}
+				for i, operand in instr.operands {
+					role := if instr.is_block_operand(i) {
+						'block'
+					} else if instr.is_definition_operand(i) {
+						'definition'
+					} else {
+						'use'
+					}
+					operands << VGuardOperand{
+						id:   int(operand)
+						role: role
+						kind: if role != 'block' && operand >= 0 && operand < m.values.len {
+							m.values[operand].kind.str()
+						} else {
+							''
+						}
+					}
+				}
+				members << int(id)
+				instructions << VGuardInstruction{
+					id:       int(id)
+					block:    int(block_id)
+					function: func.name
+					op:       instr.op.str()
+					typ:      int(value.typ)
+					atomic:   instr.atomic_ord.str()
+					inline:   instr.inline.str()
+					asm_id:   instr.asm_id
+					operands: operands
+					ast:      m.vguard_ast_at(a, value.index)
+				}
+			}
+			if members.len > 0 {
+				last := m.instrs[m.values[members.last()].index]
+				for i, operand in last.operands {
+					if last.is_successor_operand(i) && int(operand) !in successors {
+						successors << int(operand)
+					}
+				}
+			}
+			blocks << VGuardBlock{
+				id:           int(block_id)
+				function:     func.name
+				instructions: members
+				successors:   successors
+			}
+		}
+	}
+	return VGuardGraph{
+		instructions: instructions
+		blocks:       blocks
+	}
+}
+
+@[inline]
+pub fn (mut m Module) vguard_record_rewrite(old_id ValueID, new_id ValueID, user_id ValueID) {
+	if m.vguard_track_rewrites {
+		m.vguard_rewrites << VGuardRewrite{ from: int(old_id), to: int(new_id), user: int(user_id) }
+	}
+}
+
+// vguard_copy_ast records a clone made by the optimizer's inliner.
+@[inline]
+pub fn (mut m Module) vguard_copy_ast(from ValueID, to ValueID) {
+	if m.vguard_track_ast {
+		if anchor := m.vguard_ast_nodes[m.values[from].index] {
+			m.vguard_ast_nodes[m.values[to].index] = VGuardAstAnchor{
+				node:        anchor.node
+				copied_from: int(from)
+			}
+		}
+	}
+}
+
+// vguard_json_quote uses the same escaping as compiler diagnostics.
+pub fn vguard_json_quote(text string) string {
+	return '"' + errors.json_escape(text) + '"'
+}
+
+pub fn (instruction VGuardInstruction) write_vguard_json(mut out strings.Builder) {
+	out.write_string('{"id":${instruction.id},"block":${instruction.block},"function":${vguard_json_quote(instruction.function)}')
+	out.write_string(',"op":${vguard_json_quote(instruction.op)},"typ":${instruction.typ},"atomic":${vguard_json_quote(instruction.atomic)}')
+	out.write_string(',"inline":${vguard_json_quote(instruction.inline)},"asm_id":${instruction.asm_id},"operands":[')
+	for index, operand in instruction.operands {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		out.write_string('{"id":${operand.id},"role":${vguard_json_quote(operand.role)},"kind":${vguard_json_quote(operand.kind)}}')
+	}
+	out.write_u8(`]`)
+	if instruction.ast.node >= 0 {
+		ast := instruction.ast
+		out.write_string(',"ast":{"node":${ast.node},"kind":${vguard_json_quote(ast.kind)}')
+		out.write_string(',"file":${vguard_json_quote(ast.file)},"line":${ast.line},"column":${ast.column}')
+		out.write_string(',"source_file":${vguard_json_quote(ast.source_file)},"start_byte":${ast.start_byte},"end_byte":${ast.end_byte}')
+		if ast.copied_from >= 0 {
+			out.write_string(',"copied_from":${ast.copied_from}')
+		}
+		out.write_u8(`}`)
+	}
+	out.write_u8(`}`)
+}
+
+pub fn write_vguard_instructions(mut out strings.Builder, instructions []VGuardInstruction) {
+	out.write_u8(`[`)
+	for index, instruction in instructions {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		instruction.write_vguard_json(mut out)
+	}
+	out.write_u8(`]`)
+}
+
+pub fn (graph VGuardGraph) vguard_json() string {
+	mut out := strings.new_builder(4096)
+	out.write_string('{"version":${graph.version},"instructions":')
+	write_vguard_instructions(mut out, graph.instructions)
+	out.write_string(',"blocks":[')
+	for index, block in graph.blocks {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		out.write_string('{"id":${block.id},"function":${vguard_json_quote(block.function)},"instructions":${block.instructions},"successors":${block.successors}}')
+	}
+	out.writeln(']}')
+	return out.str()
+}
