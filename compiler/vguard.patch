@@ -0,0 +1,96 @@
+module driver
+
+import crypto.sha256
+import strings
+import v.errors
+import os
+import v.pref
+
+struct VGuardReturnHomeRecord {
+	value    int
+	bytes    int
+	register string
+}
+
+struct VGuardSourceRange {
+	function        string
+	symbol          string
+	body            int
+	start           int
+	end             int
+	value           int
+	op              string
+	file            string
+	line            int
+	column          int
+	recovery_prefix int
+	return_home     VGuardReturnHomeRecord
+	control_homes   VGuardControlHomesRecord
+}
+
+struct VGuardControlHomesRecord {
+	prefix_through    int
+	alternate_start   int
+	alternate_through int
+}
+
+fn vguard_json_string(s string) string {
+	return '"' + errors.json_escape(s) + '"'
+}
+
+fn write_vguard_map(path string, artifact string, prefs &pref.Preferences, hot_fn string, ranges []VGuardSourceRange, ssa_sha256 string, native_homes string, native_memory bool) ! {
+	if os.real_path(path) == os.real_path(artifact) {
+		return error('VGuard map path aliases the binary')
+	}
+	bytes := os.read_bytes(artifact)!
+	format := if hot_fn != '' { 'raw-arm64' } else { prefs.target.object_format }
+	revision := if prefs.vcurrent_hash != '' { prefs.vcurrent_hash } else { prefs.vhash }
+	mut output := strings.new_builder(1024)
+	output.write_string('{"version":1,"format":${vguard_json_string(format)}')
+	output.write_string(',"backend":${vguard_json_string(prefs.backend)},"target_os":${vguard_json_string(prefs.target.os)}')
+	output.write_string(',"arch":${vguard_json_string(prefs.target.arch)},"revision":${vguard_json_string(revision)}')
+	output.write_string(',"sha256":"${sha256.sum256(bytes).hex()}"')
+	if ssa_sha256 != '' {
+		output.write_string(',"ssa_sha256":"${ssa_sha256}"')
+	}
+	if native_memory {
+		output.write_string(',"native_memory":true')
+	}
+	output.write_string(',"ranges":[')
+	for i, r in ranges {
+		if i > 0 {
+			output.write_u8(`,`)
+		}
+		symbol := if format == 'elf' && prefs.backend == 'arm64' {
+			r.symbol.trim_string_left('_')
+		} else {
+			r.symbol
+		}
+		output.write_string('{"function":${vguard_json_string(r.function)},"symbol":${vguard_json_string(symbol)}')
+		output.write_string(',"body":${r.body},"start":${r.start},"end":${r.end},"value":${r.value}')
+		output.write_string(',"op":${vguard_json_string(r.op)},"file":${vguard_json_string(r.file)}')
+		output.write_string(',"line":${r.line},"column":${r.column}')
+		if r.recovery_prefix > 0 {
+			output.write_string(',"recovery_prefix":${r.recovery_prefix}')
+		}
+		if r.return_home.bytes > 0 {
+			output.write_string(',"return_home":{"value":${r.return_home.value},"bytes":${r.return_home.bytes},"register":${vguard_json_string(r.return_home.register)}}')
+		}
+		control := r.control_homes
+		if control.prefix_through > 0 {
+			output.write_string(',"control_homes":{"prefix_through":${control.prefix_through}')
+			if control.alternate_start > 0 {
+				output.write_string(',"alternate_start":${control.alternate_start},"alternate_through":${control.alternate_through}')
+			}
+			output.write_u8(`}`)
+		}
+		output.write_u8(`}`)
+	}
+	output.write_u8(`]`)
+	if native_homes != '' {
+		output.write_string(',"native_homes":')
+		output.write_string(native_homes)
+	}
+	output.writeln('}')
+	os.write_file(path, output.str())!
+}
diff --git a/vlib/v/driver/vguard_map_notd_skip_ssa.v b/vlib/v/driver/vguard_map_notd_skip_ssa.v
new file mode 100644
index 0000000000..1c114d014f
--- /dev/null
+++ b/vlib/v/driver/vguard_map_notd_skip_ssa.v
@@ -0,0 +1,149 @@
+module driver
+
+import crypto.sha256
+import os
+import strings
+import v.flat
+import v.pref
+import v.ssa
+import v.ssa.optimize
+import v.token
+
+fn write_vguard_ssa_map(path string, artifact string, prefs &pref.Preferences, hot_fn string, a &flat.FlatAst, m &ssa.Module, ranges []ssa.EmissionRange, homes []ssa.VGuardValueHome, native_memory bool) ! {
+	ssa_path := path + '.ssa'
+	map_path := os.real_path(path)
+	artifact_path := os.real_path(artifact)
+	if os.real_path(ssa_path) in [map_path, artifact_path] || map_path == artifact_path {
+		return error('VGuard map, SSA, and binary paths must be distinct')
+	}
+	ssa_sha256 := write_vguard_ssa(ssa_path, m, hot_fn)!
+	write_vguard_map(path, artifact, prefs, hot_fn, vguard_source_ranges(a, ranges, hot_fn),
+		ssa_sha256, if (m.vguard_track_ast || native_memory) && prefs.backend in [
+			'amd64',
+			'arm64',
+		] {
+			vguard_value_homes_json(m, homes, hot_fn)
+		} else {
+			''
+		}, native_memory)!
+}
+
+fn vguard_value_homes_json(m &ssa.Module, homes []ssa.VGuardValueHome, hot_fn string) string {
+	mut output := strings.new_builder(1024)
+	output.write_u8(`[`)
+	for home in homes {
+		if m.values[home.value].typ == 0 || (hot_fn != '' && home.function != hot_fn) {
+			continue
+		}
+		if output.len > 1 {
+			output.write_u8(`,`)
+		}
+		output.write_string('{"function":${vguard_json_string(home.function)},"value":${home.value}')
+		// Only scalar SSA definitions and arguments have homes with recoverable bits.
+		value := m.values[home.value]
+		width := m.vguard_scalar_width(home.value)
+		if m.vguard_track_ast && width > 0 && value.kind in [.argument, .instruction, .phi_result]
+			&& (home.frame_offset != 0 || home.register != '' || home.object_offset != 0) {
+			output.write_string(',"snapshot_bytes":${width}')
+			if value.kind == .argument {
+				output.write_string(',"snapshot_argument":true')
+				entry := home.argument_entry
+				if entry.ready > 0 {
+					output.write_string(',"argument_entry":{"ready":${entry.ready}')
+					if entry.register != '' {
+						output.write_string(',"register":${vguard_json_string(entry.register)}')
+						if entry.preserve_register {
+							output.write_string(',"preserve_register":true')
+						}
+					} else {
+						output.write_string(',"stack_offset":${entry.stack_offset}')
+						output.write_string(',"stack_adjusted":${entry.stack_adjusted},"frame_ready":${entry.frame_ready}')
+					}
+					output.write_u8(`}`)
+				}
+			}
+		}
+		if home.register != '' {
+			output.write_string(',"register":${vguard_json_string(home.register)}')
+		}
+		if home.frame_offset != 0 {
+			output.write_string(',"frame_offset":${home.frame_offset}')
+		}
+		if home.object_offset != 0 {
+			output.write_string(',"object_offset":${home.object_offset}')
+			if home.object_size != 0 {
+				output.write_string(',"object_size":${home.object_size},"redzone_before":${home.redzone_before},"redzone_after":${home.redzone_after}')
+			}
+			if home.object_alignment != 0 {
+				output.write_string(',"object_alignment":${home.object_alignment}')
+			}
+		}
+		output.write_u8(`}`)
+	}
+	output.write_u8(`]`)
+	return output.str()
+}
+
+// Save the final IR and preserve the same ValueIDs used by the emission ranges.
+fn write_vguard_ssa(path string, m &ssa.Module, hot_fn string) !string {
+	mut file := os.create(path)!
+	defer {
+		file.close()
+	}
+	mut hash := sha256.new()
+	header := '; VGuard SSA v2\n'.bytes()
+	file.write_full_buffer(header.data, uint(header.len))!
+	hash.write(header)!
+	for func in m.funcs {
+		if func.blocks.len == 0 || (hot_fn != '' && hot_fn != func.name) {
+			continue
+		}
+		data := m.dump_function(func).bytes()
+		file.write_full_buffer(data.data, uint(data.len))!
+		hash.write(data)!
+	}
+	return hash.sum([]u8{}).hex()
+}
+
+fn vguard_source_ranges(a &flat.FlatAst, ranges []ssa.EmissionRange, hot_fn string) []VGuardSourceRange {
+	mut result := []VGuardSourceRange{cap: ranges.len}
+	for r in ranges {
+		if hot_fn != '' && r.function != hot_fn {
+			continue
+		}
+		pos := a.source_position(r.pos) or { token.Position{} }
+		result << VGuardSourceRange{
+			function:        r.function
+			symbol:          r.symbol
+			body:            r.body
+			start:           r.start
+			end:             r.end
+			value:           r.value
+			op:              r.op.str()
+			file:            pos.filename
+			line:            pos.line
+			column:          pos.column
+			recovery_prefix: r.recovery_prefix
+			return_home:     VGuardReturnHomeRecord{
+				value:    r.return_home.value
+				bytes:    r.return_home.bytes
+				register: r.return_home.register
+			}
+			control_homes:   VGuardControlHomesRecord{
+				prefix_through:    r.control_homes.prefix_through
+				alternate_start:   r.control_homes.alternate_start
+				alternate_through: r.control_homes.alternate_through
+			}
+		}
+	}
+	return result
+}
+
+fn run_vguard_ssa_analysis(mut m ssa.Module, a &flat.FlatAst, map_path string, artifact string, skip_reason string) ! {
+	path := map_path + '.passes.jsonl'
+	output := os.real_path(artifact)
+	if output in [os.real_path(path), os.real_path(path + '.graph.json')] {
+		return error('VGuard SSA analysis path aliases the binary')
+	}
+	optimize.trace_vguard_pipeline(mut m, a, path, skip_reason)!
+}
diff --git a/vlib/v/driver/vguard_trace.v b/vlib/v/driver/vguard_trace.v
new file mode 100644
index 0000000000..79d85ba336
--- /dev/null
+++ b/vlib/v/driver/vguard_trace.v
@@ -0,0 +1,351 @@
+module driver
+
+import crypto.sha256
+import os
+import strings
+import v.flat
+import v.parser
+import v.pref
+import v.tempname
+
+struct VGuardEdit {
+	offset int
+	skip   int
+	order  int
+	text   string
+}
+
+struct VGuardTraceOptions {
+	scalars bool
+	calls   bool
+	hangs   bool
+}
+
+fn stage_vguard_trace(input string, prefs &pref.Preferences, options VGuardTraceOptions) !(string, string) {
+	root := os.join_path(os.vtmp_dir(), 'vguard-trace-' + tempname.unique_token())
+	os.mkdir(root)!
+	mut success := false
+	defer {
+		if !success {
+			os.rmdir_all(root) or {}
+		}
+	}
+	staged := os.join_path(root, os.file_name(os.real_path(input)))
+	if os.is_dir(input) {
+		vguard_trace_dir(os.real_path(input), staged, prefs, options)!
+	} else {
+		if !input.ends_with('.v') {
+			return error('VGuard tracing requires a V source file or project directory')
+		}
+		os.write_file(staged, vguard_trace_source(os.real_path(input), prefs, options)!)!
+	}
+	success = true
+	return staged, root
+}
+
+fn vguard_trace_dir(input string, output string, prefs &pref.Preferences, options VGuardTraceOptions) ! {
+	os.mkdir(output)!
+	for name in os.ls(input)! {
+		if name == '.git' {
+			continue
+		}
+		src := os.join_path(input, name)
+		dst := os.join_path(output, name)
+		if os.is_link(src) {
+			return error('VGuard trace staging cannot copy project symlink ${src}')
+		}
+		if os.is_dir(src) {
+			os.cp_all(src, dst, false)!
+		} else if name.ends_with('.v') && !name.ends_with('_test.v')
+			&& !pref.file_has_incompatible_target_suffix(name, prefs.target) {
+			os.write_file(dst, vguard_trace_source(src, prefs, options)!)!
+		} else {
+			os.cp(src, dst)!
+		}
+	}
+}
+
+fn vguard_trace_source(path string, prefs &pref.Preferences, options VGuardTraceOptions) !string {
+	source := os.read_file(path)!
+	mut p := parser.Parser.new(prefs)
+	p.vguard_record_entries = options.calls
+	p.vguard_record_loops = options.hangs
+	a := p.parse_text(path, source)
+	fastc := prefs.backend == 'fastc'
+	limited := fastc || 'vguard_fastc_trace' in prefs.user_defines
+	trace_memory := prefs.backend == 'c' && 'vguard_access_trace' in prefs.user_defines
+	helper := 'vguard_trace_value_' + sha256.hexhash(path)[..16]
+	emitter := helper + '_emit'
+	loop_emitter := helper + '_loop'
+	mut loop_instrumented := false
+	mut edits := []VGuardEdit{}
+	for loop in p.vguard_loops {
+		body := loop.body
+		loop_pos := loop.pos
+		file := a.source_files[loop_pos.id] or { continue }
+		if file.name != path {
+			continue
+		}
+		if body <= 0 || body > source.len || source[body - 1] != `{` {
+			continue
+		}
+		pos := a.source_position(loop_pos) or { continue }
+		site := pos.filename.bytes().hex()
+		// An inserted declaration would take over a label attached to the loop.
+		if loop.proof in ['', 'constant_control_loop'] && (loop.labeled || loop_pos.offset < 0
+			|| source[..int(loop_pos.offset)].trim_right(' \t\r\n').ends_with(':')) {
+			continue
+		}
+		if loop.proof == '' {
+			if loop.end <= body || loop.end > source.len || source[loop.end - 1] != `}` {
+				continue
+			}
+			loop_instrumented = true
+			count := 'vguard_loop_' + sha256.hexhash(path + loop_pos.offset.str())[..16]
+			prefix := '\\x1eVGUARD-'
+			fields := '\\t${site}\\t${pos.line}\\t${pos.column}\\t'
+			edits << VGuardEdit{
+				offset: int(loop_pos.offset)
+				text:   'mut ${count} := u64(0)\n'
+			}
+			edits << VGuardEdit{
+				offset: body
+				order:  -1
+				text:   "\n${count}++\nif ${count} >= 64 && (${count} & (${count} - 1)) == 0 {\n${loop_emitter}('${prefix}LOOP_PROGRESS${fields}' + v_getpid().str() + '\\t' + v_gettid().str() + '\\t' + ${count}.str())\n}\n"
+			}
+			edits << VGuardEdit{
+				offset: loop.end
+				text:   "\nif ${count} >= 64 {\n${loop_emitter}('${prefix}LOOP_EXIT${fields}' + v_getpid().str() + '\\t' + v_gettid().str() + '\\t' + ${count}.str())\n}\n"
+			}
+			continue
+		}
+		if loop.proof == 'constant_control_loop' {
+			// Keep the original control flow, including its dormant branches.
+			entered := 'vguard_entered_' + sha256.hexhash(path + loop_pos.offset.str())[..16]
+			message := "'\\x1eVGUARD-LOOP_PROVEN\\t${site}\\t${pos.line}\\t${pos.column}\\t' + v_getpid().str() + '\\t${loop.proof}'"
+			edits << VGuardEdit{
+				offset: int(loop_pos.offset)
+				text:   'mut ${entered} := false\n'
+			}
+			edits << VGuardEdit{
+				offset: body
+				order:  -1
+				text:   '\nif !${entered} {\n${entered} = true\n${loop_emitter}(${message})\n}\n'
+			}
+			loop_instrumented = true
+			continue
+		}
+		loop_instrumented = true
+		position := if loop.continue_pos.is_valid() { int(loop.continue_pos.offset) } else { body }
+		skip := if loop.continue_pos.is_valid() { int(loop.continue_pos.end) - position } else { 0 }
+		if position < body || skip < 0 || position + skip >= loop.end {
+			continue
+		}
+		tag := if loop.proof == 'empty_unconditional_loop' { 'LOOP' } else { 'LOOP_PROVEN' }
+		suffix := if tag == 'LOOP' { '' } else { " + '\\t${loop.proof}'" }
+		edits << VGuardEdit{
+			offset: position
+			skip:   skip
+			text:   "\n\t${loop_emitter}('\\x1eVGUARD-${tag}\\t${site}\\t${pos.line}\\t${pos.column}\\t' + v_getpid().str()${suffix})\n\tfor {}\n"
+		}
+	}
+	mut seen := map[u64]bool{}
+	mut fastc_types := map[string]bool{}
+	for index, node in a.nodes {
+		if options.calls {
+			if offset := p.vguard_entry_offsets[index] {
+				if offset > 0 && offset <= source.len && source[offset - 1] == `{` {
+					pos := a.source_position(node.pos) or { continue }
+					site := pos.filename.bytes().hex()
+					name := node.value.bytes().hex()
+					message := "'\\x1eVGUARD\\t${site}\\t${pos.line}\\t${pos.column}\\tfunction_enter\\t${name}'"
+					entry_call := if fastc {
+						'${emitter}(${message})'
+					} else if trace_memory {
+						"${emitter}(${message}, '')"
+					} else {
+						'eprintln(${message})'
+					}
+					edits << VGuardEdit{
+						offset: offset
+						order:  -source.len * 2 - 1
+						text:   '\n\t${entry_call}\n'
+					}
+				}
+			}
+		}
+		if !options.scalars {
+			continue
+		}
+		mut child := 0
+		kind := match node.kind {
+			.decl_assign, .assign {
+				if node.children_count != 2 || node.op != .assign {
+					continue
+				}
+				child = 1
+				'assignment'
+			}
+			.return_stmt {
+				if node.children_count != 1 {
+					continue
+				}
+				'return'
+			}
+			.if_expr {
+				if node.children_count < 2 {
+					continue
+				}
+				'branch'
+			}
+			else { continue }
+		}
+		expr := a.child_node(&node, child)
+		if expr.kind !in [.ident, .int_literal, .float_literal, .bool_literal, .prefix, .infix,
+			.paren, .call, .cast_expr, .index, .selector] || !expr.pos.is_valid() {
+			continue
+		}
+		mut callee := helper
+		if limited {
+			scalar_type := if kind == 'branch' || expr.kind == .bool_literal {
+				'bool'
+			} else if expr.kind == .int_literal {
+				'int'
+			} else {
+				continue
+			}
+			callee += '_' + scalar_type
+			fastc_types[scalar_type] = true
+		}
+		start := int(expr.pos.offset)
+		end := int(expr.pos.end)
+		if start < 0 || end <= start || end > source.len {
+			continue
+		}
+		key := (u64(start) << 32) | u64(end)
+		if key in seen {
+			continue
+		}
+		pos := a.source_position(expr.pos) or { continue }
+		seen[key] = true
+		site := pos.filename.bytes().hex()
+		edits << VGuardEdit{
+			offset: start
+			order:  -end
+			text:   "${callee}('\\x1eVGUARD\\t${site}\\t${pos.line}\\t${pos.column}\\t${kind}\\t', "
+		}
+		edits << VGuardEdit{
+			offset: end
+			order:  -source.len - start - 1
+			text:   ')'
+		}
+	}
+	if edits.len == 0 {
+		return source
+	}
+	edits.sort_with_compare(fn (a &VGuardEdit, b &VGuardEdit) int {
+		return if a.offset == b.offset { a.order - b.order } else { a.offset - b.offset }
+	})
+	mut result := strings.new_builder(source.len + edits.len * 64)
+	mut cursor := 0
+	for edit in edits {
+		if edit.offset < cursor {
+			return error('overlapping VGuard source instrumentation')
+		}
+		result.write_string(source[cursor..edit.offset])
+		result.write_string(edit.text)
+		cursor = edit.offset + edit.skip
+	}
+	result.write_string(source[cursor..])
+	if loop_instrumented {
+		result.writeln('')
+		result.writeln('fn ${loop_emitter}(message string) {')
+		result.writeln(r"	C.fprintf(C.stderr, c'%.*s\n', message.len, message.str)")
+		result.writeln('}')
+	}
+	if !options.scalars {
+		return result.str()
+	}
+	result.writeln('')
+	if limited {
+		if fastc {
+			result.writeln('#include <stdio.h>')
+			result.writeln('fn C.fprintf(stream voidptr, format &char, ...) int')
+			if options.calls {
+				result.writeln('fn ${emitter}(message string) {')
+				result.writeln(r"	format := '%s\n'")
+				result.writeln('	C.fprintf(C.stderr, format, message)')
+				result.writeln('}')
+			}
+		}
+		for name in ['int', 'bool'] {
+			if name !in fastc_types {
+				continue
+			}
+			result.writeln('fn ${helper}_${name}(site string, value ${name}) ${name} {')
+			if fastc {
+				if name == 'int' {
+					result.writeln(r"	format := '%s%lld\n'")
+					result.writeln('	C.fprintf(C.stderr, format, site, i64(value))')
+				} else {
+					result.writeln(r"	format := '%s%s\n'")
+					result.writeln("	text := if value { 'true' } else { 'false' }")
+					result.writeln('	C.fprintf(C.stderr, format, site, text)')
+				}
+			} else {
+				result.writeln('	eprint(site)')
+				result.writeln('	eprintln(value)')
+			}
+			result.writeln('	return value')
+			result.writeln('}')
+		}
+		return result.str()
+	}
+	if trace_memory {
+		// Checkpoints share stderr with the memory callbacks. Emit each as one record.
+		result.writeln('fn ${emitter}(site string, value string) {')
+		result.writeln(r"	C.fprintf(C.stderr, c'%.*s%.*s\n', site.len, site.str, value.len, value.str)")
+		result.writeln('}')
+	}
+	result.writeln('fn ${helper}[T](site string, value T) T {')
+	result.writeln(r'	$if T is bool || T is $int {')
+	if trace_memory {
+		result.writeln('\t\t${emitter}(site, value.str())')
+	} else {
+		result.writeln('		eprint(site)')
+		result.writeln('		eprintln(value)')
+	}
+	result.writeln(r'	} $else $if T is f32 {')
+	if trace_memory {
+		result.writeln('\t\tu32_bits := unsafe { *(&u32(&value)) }')
+		result.writeln('\t\t${emitter}(site, u32_bits.str())')
+	} else {
+		result.writeln('		eprint(site)')
+		result.writeln('		eprintln(unsafe { *(&u32(&value)) })')
+	}
+	result.writeln(r'	} $else $if T is f64 {')
+	if trace_memory {
+		result.writeln('\t\tu64_bits := unsafe { *(&u64(&value)) }')
+		result.writeln('\t\t${emitter}(site, u64_bits.str())')
+	} else {
+		result.writeln('		eprint(site)')
+		result.writeln('		eprintln(unsafe { *(&u64(&value)) })')
+	}
+	result.writeln('	}')
+	result.writeln('	return value')
+	result.writeln('}')
+	return result.str()
+}
+
+fn vguard_runtime_source_files(a &flat.FlatAst, input string) map[int]bool {
+	path := os.real_path(input)
+	directory := os.is_dir(path)
+	mut files := map[int]bool{}
+	for id, source in a.source_files {
+		name := os.real_path(source.name)
+		if name == path || (directory && name.starts_with(path + os.path_separator)) {
+			files[id] = true
+		}
+	}
+	return files
+}
diff --git a/vlib/v/errors/json.v b/vlib/v/errors/json.v
index e25590886d..404f955a78 100644
--- a/vlib/v/errors/json.v
+++ b/vlib/v/errors/json.v
@@ -131,7 +131,7 @@ fn write_json_message(mut out strings.Builder, kind string, message string, deta
 // json_escape escapes text for a JSON string. Valid UTF-8 passes through, so source text
 // stays readable. A byte that is not part of a valid sequence, as in a message quoting a
 // malformed source file, becomes U+FFFD: a strict reader rejects the whole line otherwise.
-fn json_escape(text string) string {
+pub fn json_escape(text string) string {
