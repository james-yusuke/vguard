diff --git a/vlib/v/gen/wasm/vguard_heap.v b/vlib/v/gen/wasm/vguard_heap.v
new file mode 100644
index 0000000000..bdcc55e113
--- /dev/null
+++ b/vlib/v/gen/wasm/vguard_heap.v
@@ -0,0 +1,366 @@
+module wasm
+
+import v.ssa
+
+const vguard_shadow_memory = 1
+
+struct VGuardHeap {
+mut:
+	floor     int
+	index     int
+	register  int
+	check     int
+	live_size int
+	release   int
+	bounds    int
+	retired   int
+	bad_free  int
+	capacity  int
+}
+
+// A granule records the allocation base. The base record's second word is
+// the size plus one, or zero after release. Metadata is in unexported memory.
+fn (mut c Code) vguard_shadow_word(op u8, offset int) {
+	c.raw(op)
+	leb_u(mut c.bytes, 0x42) // four-byte alignment with an explicit memory index
+	leb_u(mut c.bytes, vguard_shadow_memory)
+	leb_u(mut c.bytes, u64(offset))
+}
+
+fn (mut g SSAGen) vguard_heap_trap(kind string) int {
+	mut c := Code{}
+	c.raw(0x00) // unreachable
+	c.end()
+	body := g.mod.funcs.len
+	idx := g.mod.add_func(g.mod.add_type([], []), [], c.bytes)
+	g.vguard_ranges << ssa.EmissionRange{
+		function: '__vguard_heap_' + kind
+		body:     body
+		start:    0
+		end:      1
+		value:    -1
+		op:       .unreachable
+	}
+	return idx
+}
+
+fn (mut g SSAGen) init_vguard_heap(floor int) {
+	g.mod.vguard_shadow = true
+	g.vguard_heap.floor = floor
+	g.vguard_heap.bounds = g.vguard_heap_trap('bounds')
+	g.vguard_heap.retired = g.vguard_heap_trap('retired')
+	g.vguard_heap.bad_free = g.vguard_heap_trap('invalid_lifetime')
+	g.vguard_heap.capacity = g.vguard_heap_trap('capacity')
+	g.vguard_heap.index = g.emit_shadow_index()
+	g.vguard_heap.register = g.emit_shadow_register()
+	g.vguard_heap.check = g.emit_shadow_check()
+	g.vguard_heap.live_size = g.emit_shadow_live_size()
+	g.vguard_heap.release = g.emit_shadow_release()
+}
+
+fn (mut g SSAGen) emit_shadow_index() int {
+	mut c := Code{}
+	c.local_get(0)
+	c.i32_const(g.vguard_heap.floor)
+	c.raw(0x6b) // sub
+	c.i32_const(4)
+	c.raw(0x76) // shr_u
+	c.i32_const(3)
+	c.raw(0x74) // shl
+	c.end()
+	return g.mod.add_func(g.mod.add_type([valtype_i32], [valtype_i32]), [], c.bytes)
+}
+
+fn (mut g SSAGen) emit_shadow_register() int {
+	mut c := Code{}
+	// Parameters are the base, logical size and aligned one-past-end address.
+	start, end, cursor, pages, current := 3, 4, 5, 6, 7
+	c.local_get(0)
+	c.call(g.vguard_heap.index)
+	c.local_set(start)
+	c.local_get(2)
+	c.call(g.vguard_heap.index)
+	c.local_tee(end)
+	c.i32_const(65535)
+	c.raw(0x6a)
+	c.i32_const(16)
+	c.raw(0x76)
+	c.local_tee(pages)
+	c.raw(0x3f) // memory.size
+	c.raw(vguard_shadow_memory)
+	c.local_tee(current)
+	c.raw(0x4b) // gt_u
+	c.if_void()
+	c.local_get(pages)
+	c.local_get(current)
+	c.raw(0x6b)
+	c.raw(0x40) // memory.grow
+	c.raw(vguard_shadow_memory)
+	c.i32_const(-1)
+	c.raw(0x46)
+	c.if_void()
+	c.call(g.vguard_heap.capacity)
+	c.end()
+	c.end()
+	c.local_get(start)
+	c.local_set(cursor)
+	c.block_void()
+	c.loop_void()
+	c.local_get(cursor)
+	c.local_get(end)
+	c.raw(0x4f) // ge_u
+	c.br_if(1)
+	c.local_get(cursor)
+	c.local_get(0)
+	c.vguard_shadow_word(0x36, 0)
+	c.local_get(cursor)
+	c.i32_const(8)
+	c.raw(0x6a)
+	c.local_set(cursor)
+	c.br(0)
+	c.end()
