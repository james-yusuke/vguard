+fn (mut g SSAGen) emit_shadow_check() int {
+	mut c := Code{}
+	// Check a complete span against the allocation containing its first byte.
+	base, size, delta := 2, 3, 4
+	c.local_get(1)
+	c.raw(0x45)
+	c.if_void()
+	c.ret()
+	c.end()
+	c.local_get(0)
+	c.i32_const(g.vguard_heap.floor)
+	c.raw(0x49) // lt_u
+	c.if_void()
