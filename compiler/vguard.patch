+fn (mut g SSAGen) check_shadow_address(offset int, width int) {
+	addr := g.temp(.i32)
+	g.cur.local_tee(addr)
+	g.cur.local_get(addr)
+	if offset != 0 {
+		effective := g.temp(.i32)
+		g.cur.i32_const(offset)
+		g.cur.raw(0x6a)
+		g.cur.local_tee(effective)
+		g.cur.local_get(addr)
+		g.cur.raw(0x49)
+		g.cur.if_void()
+		g.cur.call(g.vguard_heap.bounds)
+		g.cur.end()
+		g.cur.local_get(effective)
+	}
+	g.cur.i32_const(width)
+	g.cur.call(g.vguard_heap.check)
