+++ b/vlib/v/ssa/vguard.v
@@ -0,0 +1,226 @@
+module ssa
+
+import v.token
+
+// EmissionRange connects emitted bytes inside a function to a final SSA instruction.
+pub struct EmissionRange {
+pub:
+	function string
+	body     int
+	start    int
+	end      int
+	value    ValueID
+	op       OpCode
+	pos      token.Pos
+pub mut:
+	symbol          string
+	recovery_prefix int
+	return_home     VGuardReturnHome
+	control_homes   VGuardControlHomes
+}
+
+// VGuardControlHomes marks machine instruction boundaries where the homes
+// from the incoming SSA state have not changed.
+pub struct VGuardControlHomes {
+pub:
+	prefix_through    int
+	alternate_start   int
+	alternate_through int
+}
+
+// VGuardReturnHome identifies an SSA operand in the result register after transfer.
+pub struct VGuardReturnHome {
+pub:
+	value    ValueID
+	bytes    int
+	register string
+}
+
+// VGuardValueHome records native allocator assignments for one SSA value.
+pub struct VGuardValueHome {
+pub:
+	function         string
+	value            ValueID
+	register         string
+	frame_offset     int
+	object_offset    int
+	object_alignment int
+	object_size      int
+	redzone_before   int
+	redzone_after    int
+	argument_entry   VGuardArgumentEntry
+}
+
+// VGuardArgumentEntry records the incoming ABI home and the end of its spill.
+pub struct VGuardArgumentEntry {
+pub:
+	register          string
+	stack_offset      int = -1
+	ready             int
+	stack_adjusted    int
+	frame_ready       int
+	preserve_register bool
+}
+
+// VGuardStackRegion gives the object and its poisoned neighbors relative to the frame.
+pub struct VGuardStackRegion {
+pub:
+	offset int
+	size   int
+	before int
+	after  int
+}
+
+// vguard_stack_region takes the aligned frame depth before laying out the object.
+pub fn vguard_stack_region(depth int, size int) VGuardStackRegion {
+	redzone := 32
+	span := (size + 15) & ~15
+	return VGuardStackRegion{
+		offset: -(depth + redzone + span)
+		size:   size
+		before: redzone
+		after:  redzone + span - size
+	}
+}
+
+// The 64-bit compiler-rt __asan_global record has eight pointer-sized fields.
+pub const vguard_global_record_size = 64
+pub const vguard_global_table = 'vguard.asan.globals'
+
+pub struct VGuardGlobal {
+pub:
+	name string
+	size int
+	span int
+}
+
+// vguard_global describes one global's payload and right redzone in byte units.
+pub fn (m &Module) vguard_global(global GlobalVar) VGuardGlobal {
+	typ_size := m.type_size(global.typ)
+	mut size := if typ_size > 0 { typ_size } else { 8 }
+	if global.initial_data.len > 0 {
+		size = global.initial_data.len
+	}
+	return VGuardGlobal{
+		name: global.name
+		size: size
+		span: ((size + 15) & ~15) + 32
+	}
+}
+
+// vguard_defined_globals is ordered as the object's data layout.
+pub fn (m &Module) vguard_defined_globals() []VGuardGlobal {
+	mut globals := []VGuardGlobal{}
+	for global in m.globals {
+		if global.linkage != .external {
+			globals << m.vguard_global(global)
+		}
+	}
+	return globals
+}
+
+// emission_range describes bytes attributed to one instruction.
+pub fn (m &Module) emission_range(function string, symbol string, body int, start int, end int, value ValueID) EmissionRange {
+	ins := m.instrs[m.values[value].index]
+	return EmissionRange{
+		function: function
+		symbol:   symbol
+		body:     body
+		start:    start
+		end:      end
+		value:    value
+		op:       ins.op
+		pos:      ins.pos
+	}
+}
+
+// vguard_runtime_function is true for code with an instruction from the traced input.
+pub fn (m &Module) vguard_runtime_function(func Function) bool {
+	if m.vguard_runtime_files.len == 0 {
+		return false
+	}
+	for block in func.blocks {
+		for value in m.blocks[block].instrs {
+			if value >= 0 && value < m.values.len && m.values[value].kind == .instruction
+				&& int(m.instrs[m.values[value].index].pos.id) in m.vguard_runtime_files {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// vguard_scalar_width reports the native scalar size that can be sampled.
+pub fn (m &Module) vguard_scalar_width(value int) int {
+	if value < 0 || value >= m.values.len {
+		return 0
+	}
+	typ := m.values[value].typ
+	if typ <= 0 || typ >= m.type_store.types.len {
+		return 0
+	}
+	if m.type_store.types[typ].kind !in [.int_t, .float_t, .ptr_t] {
+		return 0
+	}
+	size := m.type_size(typ)
+	return if size in [1, 2, 4, 8] { size } else { 0 }
+}
+
+// vguard_return_home describes a scalar result with the operand's declared type.
+pub fn (m &Module) vguard_return_home(instruction ValueID, result TypeID, register string, float_register string) VGuardReturnHome {
+	operands := m.instrs[m.values[instruction].index].operands
+	if operands.len != 1 {
+		return VGuardReturnHome{}
+	}
+	value := operands[0]
+	bytes := m.vguard_scalar_width(value)
+	if bytes == 0 || m.values[value].typ != result {
+		return VGuardReturnHome{}
+	}
+	return VGuardReturnHome{
+		value:    value
+		bytes:    bytes
+		register: if m.type_store.types[result].kind == .float_t {
+			float_register
+		} else {
+			register
+		}
+	}
+}
+
+// vguard_memory_operand identifies scalar pointer operands and access sizes.
+pub fn (m &Module) vguard_memory_operand(id int) (int, int, int) {
+	instr := m.instrs[m.values[id].index]
+	match instr.op {
+		.load, .atomic_load {
+			return 5, instr.operands[0], m.vguard_scalar_width(id)
+		}
+		.store, .atomic_store {
+			ptr := instr.operands[1]
+			ptr_type := m.values[ptr].typ
+			if ptr_type > 0 && ptr_type < m.type_store.types.len {
+				info := m.type_store.types[ptr_type]
+				if info.kind == .ptr_t && info.elem_type > 0 && info.elem_type < m.type_store.types.len {
+					elem := m.type_store.types[info.elem_type]
+					if elem.kind in [.int_t, .float_t, .ptr_t] {
+						size := m.type_size(info.elem_type)
+						if size in [1, 2, 4, 8] {
+							return 6, ptr, size
+						}
+					}
+				}
+			}
+		}
+		else {}
+	}
+	return 0, -1, 0
+}
+
+// vguard_result_value resolves a completed lowered phi copy to its destination.
+pub fn (m &Module) vguard_result_value(id int) int {
+	instr := m.instrs[m.values[id].index]
+	if instr.op == .assign && instr.operands.len == 2 {
+		return instr.operands[0]
+	}
+	return id
+}
diff --git a/vlib/v/ssa/vguard_graph.v b/vlib/v/ssa/vguard_graph.v
new file mode 100644
index 0000000000..998075dfeb
--- /dev/null
+++ b/vlib/v/ssa/vguard_graph.v
@@ -0,0 +1,282 @@
+module ssa
+
+import crypto.sha256
+import strings
+import v.flat
+import v.errors
+
+// VGuardOperand records the role assigned by the compiler, including phi edges
+// and the destination of lowered phi copies.
+pub struct VGuardOperand {
+pub:
+	id            int
+	role          string
+	kind          string
+	text          string
+	literal_bytes int
+}
+
+struct VGuardAstAnchor {
+	node        int
+	copied_from int = -1
+}
+
+// VGuardAst is the builder's active FlatAst node at instruction allocation.
+pub struct VGuardAst {
+pub:
+	node        int = -1
+	kind        string
+	file        string
+	line        int
+	column      int
+	source_file string
+	start_byte  int
+	end_byte    int
+	copied_from int = -1
+}
+
+pub struct VGuardInstruction {
+pub:
+	id       int
+	block    int
+	function string
+	op       string
+	typ      int
+	atomic   string
+	inline   string
+	asm_id   int
+	operands []VGuardOperand
+	ast      VGuardAst
+}
+
+pub struct VGuardBlock {
+pub:
+	id           int
+	function     string
+	instructions []int
+	successors   []int
+}
+
+pub struct VGuardGraph {
+pub:
+	version      int = 1
+	instructions []VGuardInstruction
+	blocks       []VGuardBlock
+}
+
+pub struct VGuardRewrite {
+pub:
+	from int
+	to   int
+	user int
+}
+
+fn (m &Module) vguard_ast_at(a &flat.FlatAst, index int) VGuardAst {
+	anchor := m.vguard_ast_nodes[index] or { return VGuardAst{} }
+	node := a.nodes[anchor.node]
+	pos := a.source_position(node.pos) or { return VGuardAst{} }
+	physical := a.source_files[node.pos.id] or { return VGuardAst{} }
+	return VGuardAst{
+		node:        anchor.node
+		kind:        node.kind.str()
+		file:        pos.filename
+		line:        pos.line
+		column:      pos.column
+		source_file: physical.name
+		start_byte:  int(node.pos.offset)
+		end_byte:    int(node.pos.end)
+		copied_from: anchor.copied_from
+	}
+}
+
+fn vguard_operand_text(value &Value) string {
+	if value.kind !in [.constant, .argument, .global, .func_ref, .string_literal, .c_string_literal]
+		|| value.name == '' {
+		return ''
+	}
+	if value.name.len > 96 {
+		return 'sha256:' + sha256.hexhash(value.name)
+	}
+	return value.name
+}
+
+fn (m &Module) vguard_integer_literal_bytes(id ValueID) int {
+	value := m.values[id]
+	if value.kind != .constant || value.typ <= 0 || value.typ >= m.type_store.types.len {
+		return 0
+	}
+	kind := m.type_store.types[value.typ].kind
+	if kind == .int_t || (kind == .ptr_t && value.name == '0') {
+		return m.vguard_scalar_width(id)
+	}
+	return 0
+}
+
+// vguard_graph captures the live instruction lists and compiler operand roles.
+// Derive successor edges from terminators so this works before CFG analysis too.
+pub fn (m &Module) vguard_graph(a &flat.FlatAst) VGuardGraph {
+	mut instructions := []VGuardInstruction{}
+	mut blocks := []VGuardBlock{}
+	for func in m.funcs {
+		for block_id in func.blocks {
+			if block_id < 0 || block_id >= m.blocks.len {
+				continue
+			}
+			block := m.blocks[block_id]
+			mut members := []int{cap: block.instrs.len}
+			mut successors := []int{}
+			for id in block.instrs {
+				if id < 0 || id >= m.values.len {
+					continue
+				}
+				value := m.values[id]
+				if value.kind != .instruction || value.index < 0 || value.index >= m.instrs.len {
+					continue
+				}
+				instr := m.instrs[value.index]
+				mut operands := []VGuardOperand{cap: instr.operands.len}
+				for i, operand in instr.operands {
+					role := if instr.is_block_operand(i) {
+						'block'
+					} else if instr.is_definition_operand(i) {
+						'definition'
+					} else {
+						'use'
+					}
+					operands << VGuardOperand{
+						id:            int(operand)
+						role:          role
+						kind:          if role != 'block' && operand >= 0 && operand < m.values.len {
+							m.values[operand].kind.str()
+						} else {
+							''
+						}
+						text:          if role != 'block' && operand >= 0 && operand < m.values.len {
+							vguard_operand_text(&m.values[operand])
+						} else {
+							''
+						}
+						literal_bytes: if role == 'use' && operand >= 0 && operand < m.values.len {
+							m.vguard_integer_literal_bytes(operand)
+						} else {
+							0
+						}
+					}
+				}
+				members << int(id)
+				instructions << VGuardInstruction{
+					id:       int(id)
+					block:    int(block_id)
+					function: func.name
+					op:       instr.op.str()
+					typ:      int(value.typ)
+					atomic:   instr.atomic_ord.str()
+					inline:   instr.inline.str()
+					asm_id:   instr.asm_id
+					operands: operands
+					ast:      m.vguard_ast_at(a, value.index)
+				}
+			}
+			if members.len > 0 {
+				last := m.instrs[m.values[members.last()].index]
+				for i, operand in last.operands {
+					if last.is_successor_operand(i) && int(operand) !in successors {
+						successors << int(operand)
+					}
+				}
+			}
+			blocks << VGuardBlock{
+				id:           int(block_id)
+				function:     func.name
+				instructions: members
+				successors:   successors
+			}
+		}
+	}
+	return VGuardGraph{
+		instructions: instructions
+		blocks:       blocks
+	}
+}
+
+@[inline]
+pub fn (mut m Module) vguard_record_rewrite(old_id ValueID, new_id ValueID, user_id ValueID) {
+	if m.vguard_track_rewrites {
+		m.vguard_rewrites << VGuardRewrite{ from: int(old_id), to: int(new_id), user: int(user_id) }
+	}
+}
+
+// vguard_copy_ast records a clone made by the optimizer's inliner.
+@[inline]
+pub fn (mut m Module) vguard_copy_ast(from ValueID, to ValueID) {
+	if m.vguard_track_ast {
+		if anchor := m.vguard_ast_nodes[m.values[from].index] {
+			m.vguard_ast_nodes[m.values[to].index] = VGuardAstAnchor{
+				node:        anchor.node
+				copied_from: int(from)
+			}
+		}
+	}
+}
+
+// vguard_json_quote uses the same escaping as compiler diagnostics.
+pub fn vguard_json_quote(text string) string {
+	return '"' + errors.json_escape(text) + '"'
+}
+
+pub fn (instruction VGuardInstruction) write_vguard_json(mut out strings.Builder) {
+	out.write_string('{"id":${instruction.id},"block":${instruction.block},"function":${vguard_json_quote(instruction.function)}')
+	out.write_string(',"op":${vguard_json_quote(instruction.op)},"typ":${instruction.typ},"atomic":${vguard_json_quote(instruction.atomic)}')
+	out.write_string(',"inline":${vguard_json_quote(instruction.inline)},"asm_id":${instruction.asm_id},"operands":[')
+	for index, operand in instruction.operands {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		out.write_string('{"id":${operand.id},"role":${vguard_json_quote(operand.role)},"kind":${vguard_json_quote(operand.kind)}')
+		if operand.text != '' {
+			out.write_string(',"text":${vguard_json_quote(operand.text)}')
+		}
+		if operand.literal_bytes > 0 {
+			out.write_string(',"literal_bytes":${operand.literal_bytes}')
+		}
+		out.write_u8(`}`)
+	}
+	out.write_u8(`]`)
+	if instruction.ast.node >= 0 {
+		ast := instruction.ast
+		out.write_string(',"ast":{"node":${ast.node},"kind":${vguard_json_quote(ast.kind)}')
+		out.write_string(',"file":${vguard_json_quote(ast.file)},"line":${ast.line},"column":${ast.column}')
+		out.write_string(',"source_file":${vguard_json_quote(ast.source_file)},"start_byte":${ast.start_byte},"end_byte":${ast.end_byte}')
+		if ast.copied_from >= 0 {
+			out.write_string(',"copied_from":${ast.copied_from}')
+		}
+		out.write_u8(`}`)
+	}
+	out.write_u8(`}`)
+}
+
+pub fn write_vguard_instructions(mut out strings.Builder, instructions []VGuardInstruction) {
+	out.write_u8(`[`)
+	for index, instruction in instructions {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		instruction.write_vguard_json(mut out)
+	}
+	out.write_u8(`]`)
+}
+
+pub fn (graph VGuardGraph) vguard_json() string {
+	mut out := strings.new_builder(4096)
+	out.write_string('{"version":${graph.version},"instructions":')
+	write_vguard_instructions(mut out, graph.instructions)
+	out.write_string(',"blocks":[')
+	for index, block in graph.blocks {
+		if index > 0 {
+			out.write_u8(`,`)
+		}
+		out.write_string('{"id":${block.id},"function":${vguard_json_quote(block.function)},"instructions":${block.instructions},"successors":${block.successors}}')
+	}
+	out.writeln(']}')
+	return out.str()
+}
