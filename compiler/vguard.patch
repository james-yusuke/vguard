+++ b/vlib/v/ssa/dump.v
@@ -0,0 +1,41 @@
+module ssa
+
+import strings
+
+// dump_function formats SSA for the native backend's debug dump.
+pub fn (m &Module) dump_function(func &Function) string {
+	mut output := strings.new_builder(1024)
+	output.writeln('SSA function ${func.name} ret=${func.typ}')
+	for param in func.params {
+		value := m.values[param]
+		typ := m.type_store.types[value.typ]
+		output.writeln('SSA param ${param} typ=${value.typ} kind=${value.kind} type_kind=${typ.kind} size=${m.type_size(value.typ)} elem=${typ.elem_type} fields=${typ.fields} names=${typ.field_names}')
+	}
+	for block_id in func.blocks {
+		output.writeln('SSA block ${block_id}')
+		for value_id in m.blocks[block_id].instrs {
+			value := m.values[value_id]
+			if value.kind != .instruction {
+				output.writeln('SSA ${value_id} kind=${value.kind} typ=${value.typ} name=${ssa_dump_name(value.name)}')
+				continue
+			}
+			instr := m.instrs[value.index]
+			mut operands := []string{}
+			for i, operand_id in instr.operands {
+				if instr.is_value_operand(i) {
+					operand := m.values[operand_id]
+					operands << '${operand_id}:${operand.kind}:${operand.typ}:${ssa_dump_name(operand.name)}'
+				} else {
+					operands << '${operand_id}'
+				}
+			}
+			output.writeln('SSA ${value_id} ${instr.op} typ=${value.typ} ops=${operands}')
+		}
+	}
+	return output.str()
+}
+
+// String literals can contain newlines. Keep every SSA record on one line.
+fn ssa_dump_name(name string) string {
+	return name.replace_each(['\r', '\\r', '\n', '\\n'])
+}
