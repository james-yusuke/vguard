+	c.local_get(1)
+	c.i32_const(g.vguard_heap.floor)
+	c.local_get(0)
+	c.raw(0x6b)
+	c.raw(0x4b)
+	c.if_void()
+	c.call(g.vguard_heap.bounds)
+	c.end()
+	c.ret()
+	c.end()
+	c.local_get(0)
+	c.global_get(g.heap_global)
+	c.raw(0x4f)
+	c.if_void()
+	c.call(g.vguard_heap.bounds)
+	c.end()
+	c.local_get(0)
+	c.call(g.vguard_heap.index)
+	c.vguard_shadow_word(0x28, 0)
+	c.local_tee(base)
+	c.raw(0x45)
+	c.if_void()
+	c.call(g.vguard_heap.bounds)
+	c.end()
+	c.local_get(base)
+	c.call(g.vguard_heap.index)
+	c.vguard_shadow_word(0x28, 4)
+	c.local_tee(size)
+	c.raw(0x45)
+	c.if_void()
+	c.call(g.vguard_heap.retired)
+	c.end()
+	c.local_get(size)
+	c.i32_const(1)
+	c.raw(0x6b)
+	c.local_set(size)
+	c.local_get(0)
+	c.local_get(base)
+	c.raw(0x6b)
+	c.local_tee(delta)
+	c.local_get(size)
+	c.raw(0x4b)
+	c.if_void()
+	c.call(g.vguard_heap.bounds)
+	c.end()
+	c.local_get(1)
+	c.local_get(size)
+	c.local_get(delta)
+	c.raw(0x6b)
+	c.raw(0x4b)
+	c.if_void()
+	c.call(g.vguard_heap.bounds)
+	c.end()
+	c.end()
