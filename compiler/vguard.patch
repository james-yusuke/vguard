+
+fn (mut g SSAGen) check_shadow_store(typ WType, offset int, width int) {
+	value := g.temp(typ)
+	g.cur.local_set(value)
+	g.check_shadow_address(offset, width)
+	g.cur.local_get(value)
+}
+
+fn (mut g SSAGen) emit_guarded_allocator() {
+	mut c := Code{}
+	base, end, pages, widened := 1, 2, 3, 4
+	c.global_get(g.heap_global)
+	c.local_tee(base)
+	c.raw(0xad) // i64.extend_i32_u
+	c.local_get(0)
+	c.i32_const(1)
+	c.local_get(0)
+	c.raw(0x1b) // Every allocation, including size zero, gets its own aligned address.
+	c.raw(0xad)
+	c.raw(0x7c) // i64.add
+	c.i64_const(15)
+	c.raw(0x7c)
+	c.i64_const(-16)
+	c.raw(0x83) // i64.and
+	c.local_tee(widened)
+	c.i64_const(0xfffffff0)
+	c.raw(0x56) // i64.gt_u
+	c.if_void()
+	c.call(g.vguard_heap.capacity)
+	c.end()
+	c.local_get(widened)
+	c.raw(0xa7)
+	c.local_tee(end)
+	// A ceiling division without an overflowing i32 addition near 4 GiB.
+	c.i32_const(1)
+	c.raw(0x6b)
+	c.i32_const(16)
+	c.raw(0x76)
+	c.i32_const(1)
+	c.raw(0x6a)
+	c.raw(0x3f)
+	c.raw(0x00)
+	c.raw(0x6b)
+	c.local_tee(pages)
+	c.i32_const(0)
+	c.raw(0x4a) // gt_s: a negative difference needs no growth.
+	c.if_void()
+	c.local_get(pages)
+	c.raw(0x40)
+	c.raw(0x00)
+	c.i32_const(-1)
+	c.raw(0x46)
+	c.if_void()
+	c.call(g.vguard_heap.capacity)
+	c.end()
+	c.end()
+	c.local_get(base)
+	c.i32_const(0)
+	c.local_get(0)
+	c.raw(0xfc)
+	c.raw(0x0b)
+	c.raw(0x00)
+	c.local_get(base)
+	c.local_get(0)
+	c.local_get(end)
+	c.call(g.vguard_heap.register)
+	c.local_get(end)
+	c.global_set(g.heap_global)
+	c.local_get(base)
+	c.end()
+	g.mod.add_func(g.mod.add_type([valtype_i32], [valtype_i32]),
+		[valtype_i32, valtype_i32, valtype_i32, valtype_i64], c.bytes)
+}
