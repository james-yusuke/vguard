+	c.local_get(0)
+	c.global_get(g.heap_global)
+	c.raw(0x4f)
+	c.raw(0x72) // or
+	c.if_void()
+	c.call(g.vguard_heap.bad_free)
+	c.end()
+	c.local_get(0)
+	c.call(g.vguard_heap.index)
+	c.local_tee(1)
+	c.vguard_shadow_word(0x28, 0)
+	c.local_get(0)
+	c.raw(0x47)
+	c.local_get(0)
+	c.i32_const(15)
+	c.raw(0x71)
+	c.raw(0x72)
+	c.if_void()
+	c.call(g.vguard_heap.bad_free)
+	c.end()
+	c.local_get(1)
+	c.vguard_shadow_word(0x28, 4)
+	c.local_tee(1)
+	c.raw(0x45)
+	c.if_void()
+	c.call(g.vguard_heap.bad_free)
+	c.end()
