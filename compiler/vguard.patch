index 0000000000..b373caea2f
--- /dev/null
+++ b/vlib/v/gen/amd64/vguard_atomic.v
@@ -0,0 +1,63 @@
+module amd64
+
+import v.ssa
+
+// x86-64 needs a locked store or read-modify-write for a sequentially
+// consistent write. Load ordering follows the native x86-64 memory model.
+fn (mut g Gen) gen_vguard_atomic(val_id int, instr ssa.Instruction) {
+	if instr.op == .fence {
+		g.emit(0x0f)
+		g.emit(0xae)
+		g.emit(0xf0) // mfence
+		return
+	}
+	is_store := instr.op == .atomic_store
+	ptr_id := if is_store { instr.operands[1] } else { instr.operands[0] }
+	typ := g.m.values[if is_store { instr.operands[0] } else { val_id }].typ
+	width := g.m.type_size(typ)
+	if g.vguard_memory {
+		g.vguard_check_scalar(ptr_id, width, instr.op != .atomic_load)
+	}
+	g.load_val_to_reg(int(r11), ptr_id)
+	if instr.op == .atomic_load {
+		g.emit_sized_load_base_disp(r11, 0, width)
+	} else {
+		input := if is_store { instr.operands[0] } else { instr.operands[1] }
+		g.load_val_to_reg(int(r10), input)
+		if instr.op == .cmpxchg {
+			asm_mov_reg_reg(mut g, rax, r10)
+			g.load_val_to_reg(int(r10), instr.operands[2])
+		}
+		if instr.op == .atomic_sub {
+			g.emit(0x49)
+			g.emit(0xf7)
+			g.emit(0xda) // neg r10
+		}
+		exchange := instr.op in [.atomic_store, .atomic_xchg]
+		if !exchange {
+			g.emit(0xf0) // lock
+		}
+		if width == 2 {
+			g.emit(0x66)
+		}
+		g.emit(if width == 8 { u8(0x4d) } else { u8(0x45) })
+		narrow := if width == 1 { u8(0) } else { u8(1) }
+		if exchange {
+			g.emit(0x86 + narrow) // xchg [r11], r10
+		} else {
+			g.emit(0x0f)
+			g.emit(if instr.op == .cmpxchg { 0xb0 + narrow } else { 0xc0 + narrow })
+		}
+		g.emit(0x13) // ModRM [r11], r10
+		if !is_store && instr.op != .cmpxchg {
+			asm_mov_reg_reg(mut g, rax, r10)
+		}
+	}
+	if !is_store {
+		info := g.m.type_store.types[typ]
+		if info.kind == .int_t && info.width < 64 {
+			g.canonicalize_narrow_int(info)
+		}
+		g.store_reg_to_val(int(rax), val_id)
+	}
+}
diff --git a/vlib/v/gen/amd64/vguard_memory.v b/vlib/v/gen/amd64/vguard_memory.v
new file mode 100644
index 0000000000..d0cf48f27e
--- /dev/null
+++ b/vlib/v/gen/amd64/vguard_memory.v
@@ -0,0 +1,101 @@
+module amd64
+
+import v.ssa
+
+fn (mut g Gen) vguard_check_scalar(ptr_id int, width int, write bool) {
+	g.load_val_to_reg(int(rdi), ptr_id)
+	g.vguard_check_region(if width in [1, 2, 4] { width } else { 8 }, write)
+}
+
+fn (mut g Gen) vguard_check_region(size int, write bool) {
+	g.vguard_shadow_call('__asan_region_is_poisoned', size)
+	asm_test_rax_rax(mut g)
+	asm_je_rel32(mut g)
+	skip := g.elf.text_data.len
+	g.emit_u32(0)
+	// Report with the generated frame's PC, frame pointer and stack pointer.
+	asm_mov_reg_reg(mut g, rcx, rax)
+	asm_lea_reg_rip(mut g, rdi)
+	g.emit_u32(0)
+	asm_mov_reg_reg(mut g, rsi, rbp)
+	asm_mov_reg_reg(mut g, rdx, rsp)
+	asm_mov_reg_imm64(mut g, r8, u64(if write { 1 } else { 0 }))
+	asm_mov_reg_imm64(mut g, r9, u64(size))
+	g.vguard_runtime_call('__asan_report_error')
+	g.write_u32(skip, u32(g.elf.text_data.len - (skip + 4)))
+}
+
+fn (mut g Gen) vguard_poison_frame() {
+	for value in g.vguard_stack_regions.keys().sorted() {
+		region := g.vguard_stack_regions[value]
+		asm_lea_rbp_disp(mut g, rdi, region.offset - region.before)
+		g.vguard_shadow_call('__asan_poison_memory_region', region.before)
+		asm_lea_rbp_disp(mut g, rdi, region.offset + region.size)
+		g.vguard_shadow_call('__asan_poison_memory_region', region.after)
+	}
+}
+
+fn (mut g Gen) vguard_unpoison_frame() {
+	size := g.stack_size + g.used_regs.len * 8
+	asm_lea_rbp_disp(mut g, rdi, -size)
+	g.vguard_shadow_call('__asan_unpoison_memory_region', size)
+}
+
+fn (mut g Gen) vguard_shadow_call(name string, size int) {
+	asm_mov_reg_imm64(mut g, rsi, u64(size))
+	g.vguard_runtime_call(name)
+}
+
+fn (mut g Gen) vguard_runtime_call(name string) {
+	aligned := g.used_regs.len % 2 == 0
+	if !aligned {
+		asm_sub_rsp_imm8(mut g, 8)
+	}
+	asm_call_rel32(mut g)
+	symbol := g.elf.add_undefined(name)
+	g.elf.add_text_reloc(u64(g.elf.text_data.len), symbol, r_x86_64_plt32, -4)
+	g.emit_u32(0)
+	if !aligned {
+		asm_add_rsp_imm8(mut g, 8)
+	}
+}
+
+fn (mut g Gen) vguard_register_globals() {
+	globals := g.m.vguard_defined_globals()
+	if globals.len == 0 {
+		return
+	}
+	module_name := g.vguard_global_name('VGuard native globals')
+	table := g.elf.add_undefined(ssa.vguard_global_table)
+	g.vguard_rip_address(r10, table)
+	for index, global in globals {
+		offset := index * ssa.vguard_global_record_size
+		address := g.elf.add_undefined(global.name)
+		g.vguard_rip_address(rax, address)
+		asm_mov_mem_base_disp_rax(mut g, r10, offset)
+		asm_mov_reg_imm64(mut g, rax, u64(global.size))
+		asm_mov_mem_base_disp_rax(mut g, r10, offset + 8)
+		asm_mov_reg_imm64(mut g, rax, u64(global.span))
+		asm_mov_mem_base_disp_rax(mut g, r10, offset + 16)
+		name := g.vguard_global_name(global.name)
+		g.vguard_rip_address(rax, name)
+		asm_mov_mem_base_disp_rax(mut g, r10, offset + 24)
+		g.vguard_rip_address(rax, module_name)
+		asm_mov_mem_base_disp_rax(mut g, r10, offset + 32)
+	}
+	asm_mov_reg_reg(mut g, rdi, r10)
+	g.vguard_shadow_call('__asan_register_globals', globals.len)
+}
+
+fn (mut g Gen) vguard_global_name(name string) int {
+	start := g.elf.rodata.len
+	g.elf.rodata << name.bytes()
+	g.elf.rodata << 0
+	return g.elf.add_symbol('vguard.asan.name.${start}', u64(start), false, 3)
+}
+
+fn (mut g Gen) vguard_rip_address(reg Reg, symbol int) {
+	asm_lea_reg_rip(mut g, reg)
+	g.elf.add_text_reloc(u64(g.elf.text_data.len), symbol, 2, -4)
+	g.emit_u32(0)
+}
diff --git a/vlib/v/gen/amd64/vguard_runtime.v b/vlib/v/gen/amd64/vguard_runtime.v
new file mode 100644
index 0000000000..fe5e621c9a
--- /dev/null
+++ b/vlib/v/gen/amd64/vguard_runtime.v
@@ -0,0 +1,18 @@
+module amd64
+
+fn (g &Gen) vguard_has_home(value int) bool {
+	return value in g.reg_map || value in g.stack_map
+}
+
+fn (mut g Gen) vguard_trace_event(kind int, id int, value int, width int) {
+	if value >= 0 {
+		g.load_val_to_reg(int(rcx), value)
+	} else {
+		asm_mov_reg_imm64(mut g, rcx, 0)
+	}
+	asm_mov_reg_imm64(mut g, rdi, u64(kind))
+	asm_mov_reg_imm64(mut g, rsi, u64(id))
+	asm_mov_reg_reg(mut g, rdx, rbp)
+	asm_mov_reg_imm64(mut g, r8, u64(width))
+	g.vguard_runtime_call('vguard_ssa_event')
+}
diff --git a/vlib/v/gen/amd64/vguard_test.v b/vlib/v/gen/amd64/vguard_test.v
new file mode 100644
index 0000000000..64d8c6e93e
--- /dev/null
+++ b/vlib/v/gen/amd64/vguard_test.v
@@ -0,0 +1,124 @@
+module amd64
+
+import v.ssa
+
+fn test_vguard_branch_homes_resume_at_the_other_phi_stub() {
+	mut m := ssa.Module.new()
+	m.vguard_enabled = true
+	integer := m.type_store.get_int(64)
+	function := m.new_function('choose', integer)
+	entry := m.add_block(function, 'entry')
+	then_block := m.add_block(function, 'then')
+	join := m.add_block(function, 'join')
+	cond := m.add_value(.argument, m.type_store.get_int(1), 'condition', 0)
+	m.func_add_param(function, cond)
+	left := m.get_or_add_const(integer, '11')
+	right := m.get_or_add_const(integer, '17')
+	branch := m.add_instr(.br, entry, 0, [cond, ssa.ValueID(then_block), ssa.ValueID(join)])
+	m.add_instr(.jmp, then_block, 0, [ssa.ValueID(join)])
+	selected := m.add_instr(.phi, join, integer, [
+		left,
+		ssa.ValueID(entry),
+		right,
+		ssa.ValueID(then_block),
+	])
+	m.add_instr(.ret, join, 0, [selected])
+
+	mut ordinary := Gen.new(m)
+	ordinary.gen()
+	m.vguard_track_ast = true
+	mut traced := Gen.new(m)
+	traced.gen()
+	assert traced.elf.text_data == ordinary.elf.text_data
+	ranges := traced.vguard_emission_ranges().filter(it.value == branch)
+	assert ranges.len == 1
+	control := ranges[0].control_homes
+	assert control.prefix_through > 0
+	assert control.alternate_start > control.prefix_through
+	assert control.alternate_through == control.alternate_start
+	assert control.alternate_start < ranges[0].end - ranges[0].start
+}
+
+fn test_vguard_records_register_and_frame_assignments_without_changing_code() {
+	mut m := ssa.Module.new()
+	m.vguard_enabled = true
+	integer := m.type_store.get_int(64)
+	pointer := m.type_store.get_ptr(integer)
+	function := m.new_function('sample', integer)
+	entry := m.add_block(function, 'entry')
+	argument := m.add_value(.argument, integer, 'n', 0)
+	m.funcs[function].params << argument
+	one := m.get_or_add_const(integer, '1')
+	slot := m.add_instr(.alloca, entry, pointer, [])
+	result := m.add_instr(.add, entry, integer, [argument, one])
+	m.add_instr(.store, entry, 0, [result, slot])
+	m.add_instr(.ret, entry, 0, [result])
+
+	mut ordinary := Gen.new_with_options(m, GenOptions{ optimize_runtime: true })
+	ordinary.gen()
+	assert ordinary.vguard_value_homes().len == 0
+	mut traced := Gen.new_with_options(m, GenOptions{ optimize_runtime: true })
+	traced.vguard_record_homes = true
+	traced.gen()
+	assert traced.elf.text_data == ordinary.elf.text_data
+	homes := traced.vguard_value_homes()
+	assigned := homes.filter(it.value == result)
+	assert assigned.len == 1
+	assert assigned[0].function == 'sample'
+	assert assigned[0].register == asm_register_names[traced.reg_map[result]]
+	assert assigned[0].register != ''
+	stack := homes.filter(it.value == slot)
+	assert stack.len == 1
+	assert stack[0].object_offset == traced.alloca_offsets[slot]
+	assert stack[0].object_offset < 0
+	assert stack[0].frame_offset == traced.stack_map[slot]
+	assert stack[0].frame_offset < stack[0].object_offset
+	code := traced.vguard_emission_ranges().filter(it.value == result)
+	assert code.len == 1
+	assert code[0].start < code[0].end
+
+	mut memory := Gen.new_with_options(m, GenOptions{ optimize_runtime: true })
+	memory.vguard_record_homes = true
+	memory.vguard_memory = true
+	memory.gen()
+	assert memory.elf.symbols.any(it.name == '__asan_region_is_poisoned')
+	assert memory.elf.symbols.any(it.name == '__asan_report_error')
+	assert memory.elf.symbols.any(it.name == '__asan_poison_memory_region')
+	assert memory.elf.symbols.any(it.name == '__asan_unpoison_memory_region')
+	protected := memory.vguard_value_homes().filter(it.value == slot)
+	assert protected.len == 1
+	assert protected[0].object_size == 8
+	assert protected[0].redzone_before == 32
+	assert protected[0].redzone_after == 40
+}
+
+fn test_vguard_registers_native_global_redzones_only_in_memory_mode() {
+	mut m := ssa.Module.new()
+	integer := m.type_store.get_int(64)
+	m.add_global_with_data('first', integer, true, [u8(7), 0, 0, 0, 0, 0, 0, 0])
+	m.add_global('second', integer)
+	m.add_external_global('external', integer)
+	function := m.new_function('main', integer)
+	entry := m.add_block(function, 'entry')
+	zero := m.get_or_add_const(integer, '0')
+	m.add_instr(.ret, entry, 0, [zero])
+
+	mut ordinary := Gen.new_with_options(m, GenOptions{})
+	ordinary.gen()
+	assert 'vguard.asan.globals' !in ordinary.elf.symbol_by_name
+	assert '__asan_register_globals' !in ordinary.elf.symbol_by_name
+
+	mut memory := Gen.new_with_options(m, GenOptions{})
+	memory.vguard_memory = true
+	memory.gen()
+	first := memory.elf.symbols[memory.elf.symbol_by_name['first']]
+	second := memory.elf.symbols[memory.elf.symbol_by_name['second']]
+	table := memory.elf.symbols[memory.elf.symbol_by_name['vguard.asan.globals']]
+	assert first.value % 8 == 0
+	assert second.value - first.value == 48
+	assert table.value - second.value == 48
+	assert memory.elf.data_data.len - int(table.value) == 2 * ssa.vguard_global_record_size
+	assert memory.elf.data_data[int(first.value)] == 7
+	assert '__asan_register_globals' in memory.elf.symbol_by_name
+	assert memory.elf.rodata.bytestr().contains('VGuard native globals')
+}
